#!/usr/bin/env bash
set -euo pipefail

readonly default_input_format="${TALK2PASTE_RECORD_INPUT_FORMAT:-pulse}"
readonly default_input_device="${TALK2PASTE_RECORD_INPUT_DEVICE:-default}"
readonly recorder_channels="${TALK2PASTE_RECORD_CHANNELS:-1}"
readonly recorder_sample_rate="${TALK2PASTE_RECORD_SAMPLE_RATE:-16000}"
readonly min_duration_seconds="${TALK2PASTE_MIN_DURATION_SECONDS:-0.5}"
readonly server_url="${TALK2PASTE_SERVER_URL:-http://127.0.0.1:9898/inference}"
readonly server_connect_timeout="${TALK2PASTE_SERVER_CONNECT_TIMEOUT:-1}"
readonly server_max_time="${TALK2PASTE_SERVER_MAX_TIME:-10}"
readonly preview_length="${TALK2PASTE_NOTIFY_PREVIEW_LENGTH:-80}"

temp_dir='/tmp'
if [ "${TMPDIR:-}" != "" ] && [ -d "$TMPDIR" ] && [ -w "$TMPDIR" ]; then
  temp_dir="$TMPDIR"
fi
temp_dir="$temp_dir/talk2paste"
readonly temp_dir

notify() {
  notify-send -t 5000 'talk2paste' "$1" >/dev/null 2>&1 || true
}

fail() {
  notify "Something didn't work as expected: $*"
  exit 1
}

new_clip_id() {
  printf '%s-%s\n' \
    "$(date '+%Y%m%dT%H%M%S.%N')" \
    "$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')"
}

is_newest_clip() {
  local clip_id="$1"
  local wav_path
  local wav_clip_id

  shopt -s nullglob
  for wav_path in "$temp_dir"/*.wav; do
    wav_clip_id="$(basename "$wav_path" .wav)"
    if [[ "$wav_clip_id" > "$clip_id" ]]; then
      shopt -u nullglob
      return 1
    fi
  done

  shopt -u nullglob
  return 0
}

get_ms() {
  local duration="$1"
  local duration_seconds="${duration%%.*}"
  local duration_fraction="${duration#*.}"
  if [ "$duration_fraction" = "$duration" ]; then
    duration_fraction='000'
  fi
  duration_fraction="${duration_fraction}000"
  duration_fraction="${duration_fraction:0:3}"
  printf '%s' "$duration_seconds$duration_fraction"
}

validate_wav() {
  local wav_path="$1"
  # wav_path must exist here

  local duration
  duration="$(
    ffprobe \
      -v error \
      -show_entries format=duration \
      -of default=noprint_wrappers=1:nokey=1 \
      "$wav_path" 2>/dev/null || true
  )"
  if [ "$duration" = "" ]; then
    return 1
  fi

  local duration_ms
  duration_ms="$(get_ms "$duration")"

  local minimum_ms
  minimum_ms="$(get_ms "$min_duration_seconds")"
  if [ "$duration_ms" -lt "$minimum_ms" ]; then
    return 2
  fi

  return 0
}

start_recording() {
  local clip_id
  clip_id="$(new_clip_id)"

  local wav_path="${temp_dir}/${clip_id}.wav"
  local pid_path="${temp_dir}/${clip_id}.pid"
  local ffmpeg_log_path="${temp_dir}/${clip_id}.ffmpeg.log"

  mkdir -p "$temp_dir"
  notify 'Recording...'

  ffmpeg -nostdin -hide_banner -loglevel error \
    -f "$default_input_format" \
    -i "$default_input_device" \
    -ac "$recorder_channels" \
    -ar "$recorder_sample_rate" \
    -c:a pcm_s16le \
    "$wav_path" >"$ffmpeg_log_path" 2>&1 &
  local ffmpeg_pid="$!"
  printf '%s\n' "$ffmpeg_pid" >"$pid_path"

  local ffmpeg_status=0
  wait "$ffmpeg_pid" || ffmpeg_status="$?"
  if [ -e "$pid_path" ]; then
    rm -f "$pid_path"
    if [ "$ffmpeg_status" -ne 0 ]; then
      # leave ffmpeg log for investigation
      rm -f "$wav_path"
      fail 'ffmpeg error'
    fi
  fi

  # now we know it's success, no need to leave the log behind
  rm -f "$ffmpeg_log_path"

  if ! is_newest_clip "$clip_id"; then
    rm -f "$wav_path"
    exit 0
  fi

  local validate_status=0
  validate_wav "$wav_path" || validate_status="$?"
  if [ "$validate_status" -ne 0 ]; then
    if [ "$validate_status" -eq 2 ]; then
      rm -f "$wav_path"
      exit 0
    fi
    fail "invalid wav $wav_path"
  fi

  notify 'Transcribing...'

  if ! is_newest_clip "$clip_id"; then
    rm -f "$wav_path"
    exit 0
  fi

  local response_path="${temp_dir}/${clip_id}.response.json"
  if ! curl \
    --silent \
    --show-error \
    --fail \
    --connect-timeout "$server_connect_timeout" \
    --max-time "$server_max_time" \
    --output "$response_path" \
    --request POST \
    --form temperature=0 \
    --form temperature_inc=0.9 \
    --form "file=@${wav_path}" \
    --form 'response_format=json' \
    "$server_url"; then
    rm -f "$wav_path" "$response_path"
    fail 'transcription error'
  fi

  rm -f "$wav_path"

  local transcript
  transcript="$(jq -r '.text // empty' <"$response_path" 2>/dev/null || true)"
  rm -f "$response_path"
  if [ "$transcript" = "" ]; then
    fail 'no transcript'
  fi

  if ! printf '%s' "$transcript" | wl-copy; then
    fail 'copy failed'
  fi

  local preview
  preview="$(printf '%s' "$transcript" | tr '\n' ' ' | tr '\r' ' ' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')"
  if [ "${#preview}" -gt "$preview_length" ]; then
    preview="${preview:0:preview_length}..."
  fi

  notify "Ready: ${preview}"
}

usage() {
  cat <<'EOF' >&2
usage: talk2paste-record

Environment:
  TALK2PASTE_RECORD_INPUT_FORMAT      ffmpeg input format (default: pipewire)
  TALK2PASTE_RECORD_INPUT_DEVICE      ffmpeg input device (default: default)
  TALK2PASTE_RECORD_CHANNELS          recorder channel count (default: 1)
  TALK2PASTE_RECORD_SAMPLE_RATE       recorder sample rate (default: 16000)
  TALK2PASTE_MIN_DURATION_SECONDS     minimum accepted duration (default: 1)
  TALK2PASTE_SERVER_URL               whisper-server URL (default: http://127.0.0.1:9898/inference)
  TALK2PASTE_SERVER_CONNECT_TIMEOUT   curl connect timeout seconds (default: 2)
  TALK2PASTE_SERVER_MAX_TIME          curl total timeout seconds (default: 120)
  TALK2PASTE_NOTIFY_PREVIEW_LENGTH    notification preview length (default: 80)
EOF
}

main() {
  case "$#" in
  0)
    start_recording >/dev/null 2>&1 &
    ;;
  *)
    usage
    exit 1
    ;;
  esac
}

main "$@"
